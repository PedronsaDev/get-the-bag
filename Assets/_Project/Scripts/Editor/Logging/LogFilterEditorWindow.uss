.log-window-root {
    padding: 12px;
    background-color: var(--unity-colors-window-background);
    flex-grow: 1;
}

.header-container {
    margin-bottom: 12px;
    padding-bottom: 8px;
    border-bottom-width: 1px;
    border-bottom-color: var(--unity-colors-default-border);
}

.window-title {
    font-size: 16px;
    -unity-font-style: bold;
    color: var(--unity-colors-label-text);
    margin-bottom: 2px;
}

.window-subtitle {
    font-size: 11px;
    color: var(--unity-colors-helpbox-text);
}

.toolbar-container {
    flex-direction: row;
    margin-bottom: 12px;
    top: 6px;
}

.toolbar-btn {
    flex-grow: 1;
    height: 26px;
    border-radius: 4px;
    font-size: 12px;
}

.section-container {
    background-color: var(--unity-colors-helpbox-background);
    border-radius: 6px;
    padding: 10px;
    margin-bottom: 10px;
    border-width: 1px;
    border-color: var(--unity-colors-helpbox-border);
}

.section-header {
    font-size: 13px;
    -unity-font-style: bold;
    color: var(--unity-colors-label-text);
    margin-bottom: 8px;
}

.channel-list-scroll {
    flex-grow: 1;
}

.channel-row {
    flex-direction: row;
    align-items: center;
    padding: 6px 8px;
    border-radius: 4px;
    margin-bottom: 2px;
    cursor: link;
}

.channel-row:hover {
    background-color: var(--unity-colors-highlight-background-hover);
}

.channel-color-badge {
    width: 12px;
    height: 12px;
    border-radius: 6px;
    margin-right: 8px;
}

.channel-label {
    flex-grow: 1;
    font-size: 12px;
    color: var(--unity-colors-label-text);
}

.channel-toggle {
    margin-right: 0;
}

.footer-info {
    font-size: 10px;
    color: var(--unity-colors-helpbox-text);
    margin-top: 8px;
    -unity-text-align: middle-center;
}
